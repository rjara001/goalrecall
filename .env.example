# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server
PORT="3010"
NODE_ENV="development"

# Stripe (Cloud Functions)
STRIPE_SECRET_KEY=""

# FIREBASE AUTH & HOSTING CONFIGURATION
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="goalrecall-bb4d0.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="goalrecall-bb4d0"
VITE_FIREBASE_STORAGE_BUCKET="goalrecall-bb4d0.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="426240990745"
VITE_FIREBASE_APP_ID="1:426240990745:web:81f1168e3bd9d6cdf69488"

# Optional fallbacks
VITE_GEMINI_API_KEY=""
DISABLE_HMR="false"

# FIREBASE EMULATORS (local)
# offset 100 en ~/.ports-registry.json
VITE_EMULATOR="false"
VITE_FIREBASE_EMULATOR_AUTH_HOST="127.0.0.1"
VITE_FIREBASE_EMULATOR_AUTH_PORT="9199"
VITE_FIREBASE_EMULATOR_FIRESTORE_HOST="127.0.0.1"
