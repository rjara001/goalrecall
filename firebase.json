{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/cv/extract-full-cv",
        "function": "apiExtractCv"
      },
      {
        "source": "/api/cv/**",
        "function": "apiExtractCv"
      },
      {
        "source": "/api/user/**",
        "function": "apiUserData"
      },
      {
        "source": "/api/public/claim-username",
        "function": "apiPublicShowcase"
      },
      {
        "source": "/api/public/delete-showcase",
        "function": "apiPublicShowcase"
      },
      {
        "source": "/api/public/u/:username",
        "function": "apiPublicShowcase"
      },
      {
        "source": "/u/**",
        "function": "apiPublicShowcase"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|webp|svg|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 32997,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 38081,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    }
  }
}